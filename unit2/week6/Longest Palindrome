class Solution {
    public int longestPalindrome(String s) {
        int[] count = new int[128];
        int result = 0;

        for (char c : s.toCharArray()) {
            count[c]++;
        }

        for (int n : count) {
            result += (n / 2) * 2;
        }

        if (result < s.length()) {
            result++;
        }

        return result;
    }
}
